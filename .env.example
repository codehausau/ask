# API key for the endpoint you are calling.
# Not needed for a loopback OPENAI_BASE_URL (Ollama and friends ignore it).
OPENAI_API_KEY=sk-...

# Any OpenAI-compatible endpoint. Omit for api.openai.com.
#   Azure-style gateways, OpenRouter, Together, vLLM, Ollama, LM Studio, ...
# Choose it in your shell: export OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Or pass --base-url. A URL loaded only from .env cannot authorize a request,
# even when this file also supplies the API key.
# Remote endpoints require HTTPS unless --allow-insecure-http is passed.
# Loopback HTTP endpoints such as localhost are allowed without that flag.

# Ollama: `ollama serve`, then export the URL in your shell and set ASK_MODEL here.
# Drop OPENAI_API_KEY entirely for this key-free local endpoint.
# Watch num_ctx — Ollama silently truncates long context.
#   OLLAMA_CONTEXT_LENGTH=32768 ollama serve
# In your shell: export OPENAI_BASE_URL=http://localhost:11434/v1
# ASK_MODEL=qwen2.5-coder:7b

# Automatic .env files may set only the five keys shown here. Other keys are ignored.
# OPENAI_ORG_ID=org-...
# OPENAI_PROJECT_ID=proj_...
# ASK_MODEL=gpt-4o-mini
# For a custom system prompt, use --system or export ASK_SYSTEM in your shell.
