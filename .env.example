# API key for the endpoint you are calling.
# Not needed for a loopback OPENAI_BASE_URL (Ollama and friends ignore it).
OPENAI_API_KEY=sk-...

# Any OpenAI-compatible endpoint. Omit for api.openai.com.
#   Azure-style gateways, OpenRouter, Together, vLLM, Ollama, LM Studio, ...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Ollama: `ollama serve`, then set these two and drop OPENAI_API_KEY entirely.
# Watch num_ctx — Ollama silently truncates long context.
#   OLLAMA_CONTEXT_LENGTH=32768 ollama serve
# OPENAI_BASE_URL=http://localhost:11434/v1
# ASK_MODEL=qwen2.5-coder:7b

# Defaults for the CLI.
# ASK_MODEL=gpt-4o-mini
# ASK_SYSTEM=You are a precise senior engineer. Answer directly, no preamble.
