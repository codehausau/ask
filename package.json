{
  "name": "ask-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @codehaus-au/ask build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:bun": "pnpm --filter @codehaus-au/ask build && pnpm --filter @codehaus-au/ask-tui test:bun",
    "audit": "pnpm audit --audit-level high --prod",
    "check": "pnpm typecheck && pnpm test && pnpm audit",
    "ask": "node packages/ask/dist/src/cli.js",
    "tui": "pnpm -r build && node packages/ask-tui/dist/src/launcher.js",
    "refresh": "git pull --ff-only && pnpm install --frozen-lockfile && pnpm build && ask --version",
    "lint:workflows": "actionlint .github/workflows/*.yml && zizmor --persona=regular .github/"
  }
}
